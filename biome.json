{
	"$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,

		"rules": {
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useEnumInitializers": "off"
			},
			"complexity": {
				"noForEach": "off"
			},
			"correctness": {
				"noUnusedImports": {
					"fix": "safe",
					"level": "warn"
				},
				"useParseIntRadix": "off"
			},
			"recommended": true
		}
	}
}
